struct FHitGroupSystemRootConstants
{




	uint Config;


	uint IndexBufferOffsetInBytes;


	uint FirstPrimitive;


	uint UserData;



	uint GetIndexStride()
	{
		return Config & 0xFF;
	}

	uint GetVertexStride()
	{
		return (Config >> 8) & 0xFF;
	}







};

