#line 355 "/Engine/Private/Substrate/SubstrateTree.ush"
void FSubstrateTree::UpdateAllBSDFWithBottomUpOperatorVisit_Weight(
	int BSDFIndex,
	int OpIndex,
	int PreviousIsInputA)
