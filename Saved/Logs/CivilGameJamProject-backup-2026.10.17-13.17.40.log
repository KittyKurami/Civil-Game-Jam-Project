[2026.10.17-13.14.46:564][550]Cmd: 
[2026.10.17-13.14.46:582][550]Cmd: float2 uv = UV * Tiling;
[2026.10.17-13.14.46:582][550]Cmd: float  t  = Time * Speed;
[2026.10.17-13.14.46:582][550]Cmd: 
[2026.10.17-13.14.46:582][550]Cmd: float2 p1 = uv + float2( t * 0.35,  t * 0.22);
[2026.10.17-13.14.46:582][550]Cmd: float2 p2 = uv * 1.9 - float2( t * 0.28, -t * 0.19);
[2026.10.17-13.14.46:582][550]Cmd: float w1 = sin(p1.x * 5.0 + sin(p1.y * 3.7 + t * 0.9) * 1.4);
[2026.10.17-13.14.46:582][550]Cmd: float w2 = sin(p2.y * 6.3 + sin(p2.x * 2.9 - t * 0.7) * 1.2);
[2026.10.17-13.14.46:582][550]Cmd: float warp = (w1 + w2) * 0.5;
[2026.10.17-13.14.46:582][550]Cmd: 
[2026.10.17-13.14.46:582][550]Cmd: float2 q = uv + warp * Distortion;
[2026.10.17-13.14.46:582][550]Cmd: float c1 = sin(q.x * 11.0 + t * 1.7) * sin(q.y * 9.0 - t * 1.3);
[2026.10.17-13.14.46:582][550]Cmd: float c2 = sin((q.x + q.y) * 7.5 + t * 2.1);
[2026.10.17-13.14.46:582][550]Cmd: float caustic = saturate(c1 * 0.5 + c2 * 0.5 + 0.55);
[2026.10.17-13.14.46:582][550]Cmd: float height = saturate(warp * 0.5 + 0.5);
[2026.10.17-13.14.46:582][550]Cmd: float depth  = saturate(UV.y);
[2026.10.17-13.14.46:582][550]Cmd: 
[2026.10.17-13.14.46:583][550]Cmd: float3 col = lerp(ShallowColor.rgb, DeepColor.rgb, saturate(depth * 0.75 + height * 0.35));
[2026.10.17-13.14.46:583][550]Cmd: col += pow(caustic, 3.0) * 0.35;
[2026.10.17-13.14.46:583][550]Cmd: col += smoothstep(0.86, 1.0, caustic) * Foam;
[2026.10.17-13.14.46:583][550]Cmd: float a = saturate(Opacity * (0.80 + 0.20 * height));
[2026.10.17-13.14.46:583][550]Cmd: return float4(col, a);
